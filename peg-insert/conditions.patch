diff --git a/capx/integrations/franka/nut_assembly_forms.py b/capx/integrations/franka/nut_assembly_forms.py
new file mode 100644
index 0000000..edff893
--- /dev/null
+++ b/capx/integrations/franka/nut_assembly_forms.py
@@ -0,0 +1,34 @@
+from typing import Any
+
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from .nut_assembly_privileged import FrankaControlNutAssemblyPrivilegedApi
+
+
+class FrankaNutOffsetApi(FrankaControlNutAssemblyPrivilegedApi):
+    def functions(self) -> dict[str, Any]:
+        return {**super().functions(), "get_nut_handle_to_center_offset": self.get_nut_handle_to_center_offset}
+
+
+class FrankaNutTargetApi(FrankaControlNutAssemblyPrivilegedApi):
+    def functions(self) -> dict[str, Any]:
+        return {**super().functions(), "get_insertion_target_pose": self.get_insertion_target_pose}
+
+    def get_insertion_target_pose(self) -> tuple[np.ndarray, np.ndarray]:
+        """Get the gripper insertion target from the current handle, nut center and peg poses.
+
+        Returns:
+            position: (3,) XYZ in meters in the robot base frame.
+            quaternion_wxyz: (4,) WXYZ unit quaternion in the robot base frame.
+        """
+        handle, handle_q = self.sample_grasp_pose("square nut handle")
+        center, _ = self.get_object_pose("square nut")
+        peg, peg_q = self.get_object_pose("square peg")
+        axes = Rotation.from_quat(np.roll(handle_q, -1)).as_matrix()
+        if (center - handle) @ axes[:, 0] < 0:
+            axes = axes @ np.diag([-1, -1, 1])
+        # The oracle uses identical rotations for T_nut and T_handle.
+        offset = axes.T @ (handle - center)
+        peg_rotation = Rotation.from_quat(np.roll(peg_q, -1))
+        return peg + peg_rotation.apply(offset), peg_q.copy()
